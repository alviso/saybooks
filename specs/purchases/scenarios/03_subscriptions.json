{
  "name": "subscriptions: declared, confirmed, missed, lapsed",
  "spec": "purchases@0.1",
  "notes": "P-6: the record confirms a subscription; the module never assumes a charge.",
  "env": [],
  "steps": [
    {
      "act": "import_statement",
      "args": {
        "name": "card-2026-08.csv",
        "hash": "a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2",
        "kind": "card",
        "account": "Visa ending 4421",
        "currency": "NZD",
        "period_start": "2026-08-01",
        "period_end": "2026-08-31",
        "opening_balance": -180000,
        "closing_balance": 55251,
        "row_count": 4,
        "rows": [
          {
            "date": "2026-08-02",
            "amount": -1299,
            "description": "NETFLIX.COM",
            "row_index": 1,
            "raw": "02/08/2026,NETFLIX.COM,-12.99"
          },
          {
            "date": "2026-08-05",
            "amount": -4550,
            "description": "COUNTDOWN AUCKLAND",
            "row_index": 2,
            "raw": "05/08/2026,COUNTDOWN AUCKLAND,-45.50"
          },
          {
            "date": "2026-08-11",
            "amount": -8900,
            "description": "NOEL LEEMING",
            "row_index": 3,
            "raw": "11/08/2026,NOEL LEEMING,-89.00"
          },
          {
            "date": "2026-08-20",
            "amount": 250000,
            "description": "PAYMENT RECEIVED THANK YOU",
            "row_index": 4,
            "raw": "20/08/2026,PAYMENT RECEIVED THANK YOU,2500.00"
          }
        ]
      },
      "expect": {
        "ok": true
      }
    },
    {
      "act": "vocabulary",
      "args": {},
      "expect": {
        "ok": true,
        "include": {
          "unreviewed": 4
        }
      },
      "notes": "the agent reads the words in use before proposing"
    },
    {
      "act": "review_transaction",
      "args": {
        "transaction": "T-0001",
        "status": "recurring",
        "category": "entertainment",
        "vendor": "Netflix",
        "reason": "streaming, monthly"
      },
      "expect": {
        "ok": true,
        "include": {
          "status": "recurring",
          "vendor": "Netflix",
          "subscription": "SUB-0001",
          "subscription_declared": true
        }
      },
      "notes": "P-6: recurring with a vendor declares the subscription"
    },
    {
      "act": "subscriptions",
      "args": {
        "as_of": "2026-08-20"
      },
      "expect": {
        "ok": true,
        "include": {
          "count": 1,
          "active_total": 1,
          "missed_total": 0
        }
      }
    },
    {
      "act": "subscriptions",
      "args": {
        "as_of": "2026-09-10"
      },
      "expect": {
        "ok": true,
        "include": {
          "missed_total": 1
        }
      },
      "notes": "September has not charged yet as of the 10th: one missed period, still active"
    },
    {
      "act": "subscriptions",
      "args": {
        "as_of": "2026-10-15"
      },
      "expect": {
        "ok": true,
        "include": {
          "lapsed_total": 1
        }
      },
      "notes": "two periods without a charge: lapsed, derived"
    },
    {
      "act": "cancel_subscription",
      "args": {
        "subscription": "SUB-0001",
        "reason": "cancelled on the site in September"
      },
      "expect": {
        "ok": true,
        "include": {
          "status": "cancelled"
        }
      }
    }
  ]
}