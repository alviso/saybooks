{
 "name": "the whole path: order, receive, bill, match",
 "spec": "p2p@0.2",
 "today": "2099-03-10",
 "notes": "P2P-2/3/4/13: the order freezes its prices, the goods arrive through core's stock door, the bill is recorded as printed and matches. Approval is a person's act (purchases P-12); the person's half lives in contract gate 17, because scenarios run as an agent.",
 "env": [
  [
   "create_item",
   {
    "sku": "SH-48",
    "name": "Steel shelving unit 48in",
    "unit_price": 18900,
    "on_hand": 0
   },
   "a stocked item Sam resells"
  ],
  [
   "create_item",
   {
    "sku": "BR-12",
    "name": "Wall bracket 12in",
    "unit_price": 1200,
    "on_hand": 0
   },
   "another stocked item"
  ],
  [
   "create_item",
   {
    "sku": "FRT",
    "name": "Freight",
    "unit_price": 0,
    "stocked": false
   },
   "a service: nothing arrives, nothing is counted"
  ]
 ],
 "steps": [
  {
   "act": "create_po",
   "args": {
    "vendor": "Pacific Steel Supply",
    "lines": [
     {
      "item_id": "SH-48",
      "qty": 12,
      "unit_price": 8500
     },
     {
      "item_id": "BR-12",
      "qty": 50,
      "unit_price": 400
     },
     {
      "item_id": "FRT",
      "qty": 1,
      "unit_price": 12000
     }
    ],
    "expected_date": "2099-03-08",
    "vendor_ref": "Q-2207"
   },
   "expect": {
    "ok": true,
    "include": {
     "status": "draft",
     "total": 134000
    }
   },
   "notes": "12 shelving units at $85, 50 brackets at $4, freight $120"
  },
  {
   "act": "issue_po",
   "args": {
    "po": "PO-0001"
   },
   "expect": {
    "ok": true,
    "include": {
     "status": "issued"
    }
   },
   "notes": "P2P-8 prices freeze at issue"
  },
  {
   "act": "receive_goods",
   "args": {
    "po": "PO-0001",
    "lines": [
     {
      "item_id": "SH-48",
      "qty": 12
     },
     {
      "item_id": "BR-12",
      "qty": 50
     }
    ],
    "reference": "PS-7781"
   },
   "expect": {
    "ok": true,
    "include": {
     "still_to_receive": 0
    }
   },
   "notes": "P2P-4 stock enters through a receipt"
  },
  {
   "act": "po",
   "args": {
    "po": "PO-0001"
   },
   "expect": {
    "ok": true,
    "include": {
     "status": "received"
    }
   }
  },
  {
   "act": "unbilled_receipts",
   "args": {},
   "expect": {
    "ok": true,
    "include": {
     "count": 2
    }
   },
   "notes": "P2P-14 received and not yet billed: a real liability"
  },
  {
   "act": "record_vendor_bill",
   "args": {
    "po": "PO-0001",
    "number": "INV-5520",
    "bill_date": "2099-03-09",
    "terms_days": 30,
    "category": "freight",
    "lines": [
     {
      "item_id": "SH-48",
      "qty": 12,
      "unit_price": 8500
     },
     {
      "item_id": "BR-12",
      "qty": 50,
      "unit_price": 400
     },
     {
      "item_id": "FRT",
      "qty": 1,
      "unit_price": 12000
     }
    ]
   },
   "expect": {
    "ok": true,
    "include": {
     "status": "open",
     "amount": 134000
    }
   },
   "notes": "recorded as printed; it waits in Bills for a person"
  },
  {
   "act": "bill_match",
   "args": {
    "bill": "B-0001"
   },
   "expect": {
    "ok": true,
    "include": {
     "ok": true,
     "po_id": "PO-0001"
    }
   },
   "notes": "P2P-3 every line against what was received or ordered, at the order's price"
  },
  {
   "act": "approve_bill",
   "args": {
    "bill": "B-0001"
   },
   "expect": {
    "refused": "person's act"
   },
   "notes": "P2P-2 approval stays a person's act"
  }
 ]
}