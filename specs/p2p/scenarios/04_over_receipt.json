{
 "name": "receiving more than is open is refused",
 "spec": "p2p@0.2",
 "today": "2099-03-10",
 "notes": "P2P-11: over-receipts are refusals naming the quantities; services and items not on the order are never received.",
 "env": [
  [
   "create_item",
   {
    "sku": "SH-48",
    "name": "Steel shelving unit 48in",
    "unit_price": 18900,
    "on_hand": 0
   },
   "a stocked item Sam resells"
  ],
  [
   "create_item",
   {
    "sku": "BR-12",
    "name": "Wall bracket 12in",
    "unit_price": 1200,
    "on_hand": 0
   },
   "another stocked item"
  ],
  [
   "create_item",
   {
    "sku": "FRT",
    "name": "Freight",
    "unit_price": 0,
    "stocked": false
   },
   "a service: nothing arrives, nothing is counted"
  ]
 ],
 "steps": [
  {
   "act": "create_po",
   "args": {
    "vendor": "Pacific Steel Supply",
    "lines": [
     {
      "item_id": "SH-48",
      "qty": 12,
      "unit_price": 8500
     },
     {
      "item_id": "BR-12",
      "qty": 50,
      "unit_price": 400
     },
     {
      "item_id": "FRT",
      "qty": 1,
      "unit_price": 12000
     }
    ],
    "expected_date": "2099-03-08",
    "vendor_ref": "Q-2207"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "act": "issue_po",
   "args": {
    "po": "PO-0001"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "act": "receive_goods",
   "args": {
    "po": "PO-0001",
    "lines": [
     {
      "item_id": "SH-48",
      "qty": 13
     }
    ]
   },
   "expect": {
    "refused": "1 too many"
   },
   "notes": "12 ordered, 13 counted"
  },
  {
   "act": "receive_goods",
   "args": {
    "po": "PO-0001",
    "lines": [
     {
      "item_id": "FRT",
      "qty": 1
     }
    ]
   },
   "expect": {
    "refused": "is a service"
   }
  },
  {
   "act": "create_item",
   "args": {
    "sku": "DK-01",
    "name": "Desk",
    "unit_price": 30000,
    "on_hand": 0
   },
   "expect": {
    "ok": true
   }
  },
  {
   "act": "receive_goods",
   "args": {
    "po": "PO-0001",
    "lines": [
     {
      "item_id": "DK-01",
      "qty": 1
     }
    ]
   },
   "expect": {
    "refused": "is not on PO-0001"
   }
  },
  {
   "act": "receive_goods",
   "args": {
    "po": "PO-0001",
    "lines": [
     {
      "item_id": "SH-48",
      "qty": 12
     }
    ]
   },
   "expect": {
    "ok": true
   }
  },
  {
   "act": "receive_goods",
   "args": {
    "po": "PO-0001",
    "lines": [
     {
      "item_id": "SH-48",
      "qty": 1
     }
    ]
   },
   "expect": {
    "refused": "0 still open"
   }
  }
 ]
}